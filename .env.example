# ──────────────────────────────────────────────────
# Portfolio — Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Nuxt auto-maps NUXT_<KEY> to runtimeConfig.<camelCaseKey>.
# ──────────────────────────────────────────────────

# GitHub Personal Access Token (scopes: read:user, repo)
NUXT_GITHUB_TOKEN=

# Discord User ID (numeric) — used by Lanyard API
NUXT_DISCORD_USER_ID=

# Instagram Graph API Access Token
NUXT_IG_ACCESS_TOKEN=

# LinkedIn API Access Token (v2 / OAuth 2.0)
NUXT_LINKEDIN_ACCESS_TOKEN=

# Public site URL (available client-side)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
